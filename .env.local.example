# BhimShila — copy this to .env and fill in what you have.
#
# Every key here is optional. The app runs with none of them: a deterministic
# router answers most questions without a model, NDMA alerts and the national
# risk scan need no key at all, and every panel can narrate itself.
#
# Put each key on its OWN LINE with no trailing comment. An inline # is read as
# part of the value — that has broken this project once already.

# --- the assistant. Any one of these is enough; more means failover. ---
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# --- real alert delivery. Free, no business account, works today. ---
# Message @BotFather on Telegram, /newbot, paste the token here.
TELEGRAM_BOT_TOKEN=

# --- demo only: puts one recipient in every state so any regional alert
# --- reaches your phone. Message @userinfobot to find your chat id.
DEMO_TELEGRAM_CHAT_ID=

# --- production only. Without these it is a local SQLite file. ---
DATABASE_URL=
DATABASE_AUTH_TOKEN=
